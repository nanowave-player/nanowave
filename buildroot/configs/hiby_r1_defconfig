# Architecture
BR2_mipsel=y
BR2_mips_32r2=y
BR2_MIPS_OABI32=y
BR2_SOFT_FLOAT=y

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
# BR2_STATIC_LIBS=y
BR2_SHARED_LIBS=y
BR2_ENABLE_LOCALE=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y
BR2_TOOLCHAIN_BUILDROOT_INET_RPC=n

# Compiler flags
BR2_TARGET_OPTIMIZATION="-Os -march=mips32r2 -mtune=mips32r2 -mabi=32 -EL"

# Host tools
BR2_PACKAGE_HOST_CMAKE=y
BR2_PACKAGE_HOST_NINJA=y
BR2_PACKAGE_HOST_MESON=y
BR2_PACKAGE_HOST_PKGCONF=y
BR2_PACKAGE_HOST_PYTHON3=y

# Libraries
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_SQLITE=y
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_FREETYPE=y
BR2_PACKAGE_HARFBUZZ=y
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_BROTLI=y
BR2_PACKAGE_BZIP2=y
BR2_PACKAGE_EXPAT=y
BR2_PACKAGE_GRAPHITE2=y
BR2_PACKAGE_ALSA_LIB=y

# udev without deamon
# comment out everything but first to do full build
BR2_PACKAGE_EUDEV=y
BR2_PACKAGE_EUDEV_DAEMON=n
BR2_PACKAGE_EUDEV_ENABLE_HWDB=n
BR2_PACKAGE_EUDEV_RULES_GEN=n
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y

BR2_PACKAGE_XKBCOMMON=y
BR2_PACKAGE_LIBXKBCOMMON=y
BR2_PACKAGE_LIBXKBCOMMON_TOOLS=y

BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_LIBEVDEV=y
BR2_PACKAGE_MTDEV=y
BR2_PACKAGE_LIBUDEV=y # /eudev

# Strip
BR2_STRIP_strip=y