
import { VerticalBox, Button, Palette, Slider, GridBox, HorizontalBox } from "std-widgets.slint";
import {SlintAudioPlayer} from "globals.slint";

export component App inherits Window {
    default-font-family: "Lato";
    default-font-size: 16pt;
    in-out property <physical-length> swipe-area-width: 50px;

    in-out property <physical-length> cur-pos: 0px;
    in-out property <physical-length> pressed-pos: 0px;

    callback touch_event();

    in-out property <string> output_text;
    in-out property <string> position;
    callback send_clicked(string);



    // 368 x 552
    // width: 368px;
    // height: 552px;

    init => {
        // load preferences
        // restore route
        Palette.color-scheme = ColorScheme.dark; // SlintPreferences.color-scheme;

    }

    SwipeGestureHandler {
        x: 0;
        y: 0;
        width: root.width; // 368px;
        height: root.height; // 552px;
        handle-swipe-right: true; //SlintPreferences.enable-gestures;
        handle-swipe-left: true; // SlintPreferences.enable-gestures;
        swiped => {
            if (true /*SlintPreferences.enable-gestures*/) {
                if (self.current-position.x > self.pressed-position.x) {
                    // SlintNavigation.back()
                } else if (self.current-position.x < self.pressed-position.x) {
                    // SlintNavigation.forward()
                }
            }
        }
    }

    in property <[string]> items: [
        "A", "B", "C", "D", "E", "F", "G"
    ];

    property<length> spacing: 0px; // 16px;
    in-out property<int> columns: Math.floor(root.width / 150px);
    in-out property<int> rows: Math.ceil(items.length / columns);
    in-out property<int> current-index: 0;
    property<length> columns-width: (columns - 1)  * spacing;
    property<length> tile-size: (self.width - columns-width) / columns;
    Flickable {
        interactive: false;
        VerticalBox {
            /*
            Text {
                text: rows;
            }
            Text {
                text: columns;
            }



            0, 0 = 0
            0, 1 = 1
            1, 0 = 2
            1, 1 = 3
            2, 0 = 4
            2, 1 = 5

            */

            // using rows or columns does not work. Slint-Bug?
            for i in 4: HorizontalBox {
                for j in 2: Rectangle {
                    width: tile-size;
                    height: tile-size;
                    in-out property <int> current-index: i * columns + j;
                    background: #3b82f6;
                    VerticalBox {
                        /*
                        HorizontalBox {
                            Text {
                                text:i;
                            }
                            Text {
                                text:j;
                            }
                        }

                        Text {
                            text:current-index;
                        }
                        */
                        if current-index < items.length: Text {
                            text: items[current-index];
                        }

                    }

                }
            }

            /*
            Text {
                text: columns;
            }
            Text {
                text: rows;
            }
            */
        }
        /*
        VerticalBox {
            for i in rows: HorizontalBox {
                for j in columns:  Rectangle {
                    // property <int> item-index: i * j;

                    // width: root.tile-size;
                    // height: root.tile-size;
                    background: #3b82f6;

                    Text {
                      text: "a";
                    }
                }
            }

        }
        */
    }
    /*
    Flickable {
    interactive: false;
        for tile[index] in items : Rectangle {
            width: root.tile_size;
            height: root.tile_size;
            background: #3b82f6;
            x:  Math.mod(index , columns) * (root.tile_size + spacing);
            y: (index / columns) * (root.tile_size + spacing);

            Text {
                text: tile;
            }
        }

    }
*/
/*
    Flickable {
        interactive: false; // todo: does this work on the lichee??



        GridLayout {
            spacing: 10px;
            for item[index] in items: Rectangle {
                // row: current-row;
                row: (index - Math.mod(index , columns) / columns);
                background: #3b82f6;
                border-radius: 8px;

                // quadratisch
                width: tile-size;
                height: self.width;

                Text {
                    text: item;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

            }
        }
    }
